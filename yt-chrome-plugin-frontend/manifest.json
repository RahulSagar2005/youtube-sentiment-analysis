{
    "manifest_version": 3,
    "name": "YouTube Sentiment Insights",
    "version": "1.0",
    "description": "Analyzes Youtube video comments for sentiment.",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "tabs",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://52.90.160.63:8000/*",
        "https://www.googleapis.com/*",
        "https://www.youtube.com/*"
    ]
}